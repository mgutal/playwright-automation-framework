# Copy to .env and adjust
UI_BASE_URL=https://www.saucedemo.com
API_BASE_URL=https://jsonplaceholder.typicode.com
UPLOAD_BASE_URL=https://httpbin.org

UI_USERNAME=standard_user
UI_PASSWORD=secret_sauce

# Optional bearer token for protected APIs
API_TOKEN=

# Set to true to skip the UI login performed in global-setup
SKIP_AUTH_SETUP=false
LOG_LEVEL=info
