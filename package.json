{
  "name": "pw-automation-framework",
  "version": "1.0.0",
  "description": "Playwright + TypeScript framework covering UI (Page Object Model) and API testing with Excel-driven data",
  "private": true,
  "scripts": {
    "install:browsers": "playwright install --with-deps chromium",
    "data:generate": "tsx scripts/generate-test-data.ts",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "test:debug": "playwright test --debug",
    "report:html": "playwright show-report playwright-report",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "clean": "rimraf test-results playwright-report allure-results allure-report .auth"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.0.0",
    "dotenv": "^16.4.5",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "xlsx": "^0.18.5"
  }
}
